  <script>
    function trackEvent(eventName, params = {}) {
      // 構成案24: QRコードから来場までの計測（GA4イベント）
      if (typeof gtag === 'function') {
        gtag('event', eventName, params);
      }
      console.log(`[Analytics Event Tracked]: ${eventName}`, params);
    }

    // LINE共有機能
    function shareToLine() {
      trackEvent('share_line_click');
      const shareUrl = encodeURIComponent(window.location.href);
      const shareText = encodeURIComponent('【きらきら千葉版】カムイみさかスキー場で家族の雪遊びデビュー！ファミリー割引30%OFF・ソリ専用キッズタウン');
      window.open(`https://line.me/R/msg/text/?${shareText}%0A${shareUrl}`, '_blank');
    }

    // SMS共有機能
    function shareBySMS() {
      trackEvent('share_sms_click');
      const body = encodeURIComponent('カムイみさかスキー場の雪遊びファミリーLP: ' + window.location.href);
      window.location.href = `sms:?body=${body}`;
    }

    // URLコピー
    function copyCurrentUrl() {
      trackEvent('copy_url_click');
      const dummy = document.createElement('input');
      document.body.appendChild(dummy);
      dummy.value = window.location.href;
      dummy.select();
      document.execCommand('copy');
      document.body.removeChild(dummy);
      showToast('URLをクリップボードにコピーしました！');
    }

    // トースト表示
    function showToast(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toast-msg');
      toastMsg.textContent = msg;
      toast.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
      }, 2500);
    }

    // モーダル開閉
    function openModal(id) {
      document.getElementById(id).classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    // クーポン使用ロジック（セクション20）
    function useCoupon() {
      trackEvent('coupon_used');
      document.getElementById('coupon-unused').classList.add('hidden');
      const usedEl = document.getElementById('coupon-used');
      usedEl.classList.remove('hidden');
      const now = new Date();
      document.getElementById('used-date').textContent = now.toLocaleString('ja-JP');
      showToast('クーポンを使用済みにしました');
    }

    // ページロード時の初期イベント
    window.addEventListener('DOMContentLoaded', () => {
      trackEvent('lp_page_view', {
        source: 'kirakira_chiba',
        device: window.innerWidth < 768 ? 'mobile' : 'desktop'
      });
    });
  </script>

</body>
</html>
